generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("MERCHANT") // MERCHANT, ADMIN
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  merchant  Merchant?
  
  auditLogs AuditLog[]
  notifications Notification[]
}

model Merchant {
  id           String   @id @default(uuid())
  userId       String   @unique
  businessName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id                String   @id @default(uuid())
  merchantId        String
  orderId           String?
  amount            Float
  currency          String   @default("INR")
  paymentMethod     String
  status            String   // SUCCESS, FAILED, PENDING
  customerReference String?
  failureReason     String?
  riskStatus        String?
  timestamp         DateTime @default(now())
  
  merchant          Merchant @relation(fields: [merchantId], references: [id])
  
  paymentAttempts   PaymentAttempt[]
  recommendations   Recommendation[]
  supportCases      SupportCase[]
  agentActions      AgentAction[]
  riskEvents        RiskEvent[]
  refund            Refund?
}

model PaymentAttempt {
  id            String   @id @default(uuid())
  transactionId String
  status        String
  gatewayId     String?
  errorMessage  String?
  timestamp     DateTime @default(now())
  
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  messages  AIMessage[]
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // user, assistant, tool, system
  content        String
  toolCalls      String?  // JSON string
  toolCallId     String?
  createdAt      DateTime @default(now())
  
  conversation   AIConversation @relation(fields: [conversationId], references: [id])
}

model AgentAction {
  id                    String   @id @default(uuid())
  transactionId         String?
  toolName              String
  inputParams           String   // JSON string
  status                String   // PENDING, COMPLETED, REJECTED
  result                String?  // JSON string
  authorizationRequired Boolean  @default(false)
  authorizationGranted  Boolean?
  createdAt             DateTime @default(now())
  
  transaction           Transaction? @relation(fields: [transactionId], references: [id])
}

model Recommendation {
  id            String   @id @default(uuid())
  transactionId String
  type          String   // REFUND, RETRY, INVESTIGATE
  description   String
  confidence    Float
  status        String   // OPEN, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())
  
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model SupportCase {
  id            String   @id @default(uuid())
  transactionId String
  title         String
  description   String
  status        String   // OPEN, IN_PROGRESS, RESOLVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model AuditLog {
  id                    String   @id @default(uuid())
  userId                String?
  sessionId             String?
  action                String
  toolUsed              String?
  transactionId         String?
  status                String
  result                String?
  authorizationRequired Boolean  @default(false)
  authorizationGranted  Boolean?
  timestamp             DateTime @default(now())
  
  user                  User?    @relation(fields: [userId], references: [id])
}

model RiskEvent {
  id            String   @id @default(uuid())
  transactionId String
  riskScore     Float
  reasons       String
  status        String   // OPEN, INVESTIGATING, CLOSED
  createdAt     DateTime @default(now())
  
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Refund {
  id            String   @id @default(uuid())
  transactionId String   @unique
  amount        Float
  currency      String   @default("INR")
  status        String   // PENDING, COMPLETED, FAILED
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}
